# Copy to .env.local and fill in. Never commit real keys.

# Clerk (https://dashboard.clerk.com → API keys). Enable "Email address" with
# password and email verification code under User & authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Postgres. On Neon use the pooled connection string here…
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# …and the direct one for migrations (drizzle-kit).
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# Comma-separated emails that become managers on first sign-in (bootstraps staff).
VOLTIQ_MANAGER_EMAILS=you@enugudisco.com

# Secret salt for hashing IPs used in per-network rate limits.
VOLTIQ_IP_SALT=change-me-to-a-long-random-string

# Web Push for app notifications. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach if something goes wrong.
VAPID_SUBJECT=mailto:you@example.com
